{
  "name": "@infinitie/book-reader",
  "version": "0.2.0",
  "description": "Independent animated book reader with optional PDF rendering and a React adapter",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "npm run build && node scripts/demo-server.mjs",
    "prepack": "npm run build",
    "test:browser": "node tests/browser.mjs && node tests/corners.browser.mjs && node tests/loading.browser.mjs && node tests/interrupted-drag.browser.mjs",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.10"
  }
}
